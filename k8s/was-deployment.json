{
  "metadata": {
    "name": "was",
    "namespace": "websphere"
  },
  "spec": {
    "replicas": 1,
    "strategy": {
      "type": "Recreate"
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "was"
        }
      },
      "spec": {
        "containers": [
          {
            "volumeMounts": [
              {
                "readOnly": true,
                "mountPath": "/run/lab-admin",
                "name": "lab-admin"
              },
              {
                "readOnly": true,
                "mountPath": "/run/lab-db",
                "name": "lab-db"
              },
              {
                "name": "lab-auth-code",
                "mountPath": "/work/lab/runtime-auth.py",
                "subPath": "runtime-auth.py",
                "readOnly": true
              }
            ],
            "command": [
              "/bin/bash",
              "/work/lab/start-lab.sh"
            ],
            "startupProbe": {
              "timeoutSeconds": 3,
              "failureThreshold": 180,
              "tcpSocket": {
                "port": 9043
              },
              "periodSeconds": 10
            },
            "name": "was",
            "imagePullPolicy": "Never",
            "args": [],
            "image": "localhost/was-lab:jdbc-v2",
            "ports": [
              {
                "name": "console",
                "containerPort": 9043
              },
              {
                "name": "app-https",
                "containerPort": 9443
              }
            ],
            "resources": {
              "limits": {
                "cpu": "2",
                "memory": "4Gi"
              },
              "requests": {
                "cpu": "500m",
                "memory": "2Gi"
              }
            },
            "readinessProbe": {
              "periodSeconds": 10,
              "tcpSocket": {
                "port": 9443
              },
              "timeoutSeconds": 3
            }
          }
        ],
        "volumes": [
          {
            "secret": {
              "defaultMode": 292,
              "secretName": "was-lab-admin"
            },
            "name": "lab-admin"
          },
          {
            "secret": {
              "defaultMode": 292,
              "secretName": "postgres-lab-auth",
              "items": [
                {
                  "path": "app-password",
                  "key": "app-password"
                }
              ]
            },
            "name": "lab-db"
          },
          {
            "name": "lab-auth-code",
            "configMap": {
              "name": "was-lab-runtime-auth-v2",
              "defaultMode": 292
            }
          }
        ],
        "terminationGracePeriodSeconds": 90
      }
    },
    "progressDeadlineSeconds": 2400,
    "selector": {
      "matchLabels": {
        "app": "was"
      }
    }
  },
  "kind": "Deployment",
  "apiVersion": "apps/v1"
}